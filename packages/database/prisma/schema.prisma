generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum TargetType {
  FACEBOOK_PAGE
  FACEBOOK_GROUP
  WEBSITE
  OTHER
}

enum TargetMode {
  API
  MANUAL_CONFIRMATION
}

enum RunStatus {
  QUEUED
  RUNNING
  PREPARED
  COMPLETED
  FAILED
}

enum PublishJobStatus {
  QUEUED
  RUNNING
  WAITING_CONNECTION
  READY_FOR_PROVIDER
  AWAITING_CONFIRMATION
  COMPLETED
  FAILED
}

enum ConnectionProvider {
  FACEBOOK_PAGE
  WEBSITE
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTED
  EXPIRED
  MISSING_PERMISSION
  ERROR
}

model Campaign {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  status          CampaignStatus       @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  contentVariants ContentVariant[]
  targets         DistributionTarget[]
  runs            CampaignRun[]
}

model ContentVariant {
  id          String       @id @default(cuid())
  campaignId  String
  title       String?
  body        String
  mediaUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]

  @@index([campaignId])
}

model ProviderConnection {
  id                String             @id @default(cuid())
  name              String
  provider          ConnectionProvider
  status            ConnectionStatus   @default(DISCONNECTED)
  externalAccountId String?
  publicConfig      Json?
  secretEncrypted   String?
  lastTestedAt      DateTime?
  lastError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  targets           DistributionTarget[]

  @@index([provider, status])
}

model DistributionTarget {
  id           String              @id @default(cuid())
  campaignId   String
  connectionId String?
  name         String
  externalId   String?
  type         TargetType
  mode         TargetMode
  active       Boolean             @default(true)
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  campaign     Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connection   ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  publishJobs  PublishJob[]

  @@index([campaignId, active])
  @@index([connectionId])
}

model CampaignRun {
  id          String       @id @default(cuid())
  campaignId  String
  status      RunStatus    @default(QUEUED)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]

  @@index([campaignId, createdAt])
}

model PublishJob {
  id               String             @id @default(cuid())
  runId            String
  targetId         String
  contentVariantId String?
  bullJobId        String?
  status           PublishJobStatus   @default(QUEUED)
  resultUrl        String?
  error            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  run              CampaignRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  target           DistributionTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  contentVariant   ContentVariant?    @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)

  @@index([runId, status])
  @@index([targetId])
  @@index([contentVariantId])
}
